# Copy this file to .env and change values if needed.
# .env is git-ignored, so real values never end up in the repo.

# Where the Conduit app runs (website and API on the same port)
BASE_URL=http://localhost:3001

# Database used by the Conduit app (matches docker-compose.yml)
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=conduit

# Secret the app uses to sign login tokens. Any value works locally.
JWT_KEY=local-test-secret
